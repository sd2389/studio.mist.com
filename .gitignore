# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!backend/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python backend
backend/.studiovenv/
backend/.venv/
backend/uploads/
backend/*.db
backend/*.db-journal
backend/**/__pycache__/
backend/.pytest_cache/
backend/.ruff_cache/
backend/.mypy_cache/

# editor / OS
.idea/
.vscode/
*.swp
*.swo
Thumbs.db

# logs
*.log
logs/

# build artifacts
dist/
*.tgz

# local CAD test files (keep samples/README.md)
/samples/*.3dm
/samples/*.stl
/samples/*.glb
