# Browser + server: FastAPI base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8765

# Server-only override (optional). Presign/register proxies use API_URL first when set.
# Compose default is the internal backend service, not localhost.
# API_URL=http://backend:8765

# Single-host demo: set these to the public web/API origins before `docker compose up --build`.
# Do not hardcode a machine name here.
# APP_PUBLIC_URL=http://127.0.0.1:3000
# PUBLIC_API_BASE=http://127.0.0.1:8765
# CORS_ORIGINS=http://127.0.0.1:3000

# Production CDN — browser loads GLB/thumbnails/renders directly (build-time for Next)
# NEXT_PUBLIC_CDN_ORIGIN=https://cdn.studio.mist.com
# NEXT_PUBLIC_SOURCE_ASSET_ORIGIN=https://assets.studio.mist.com

# FastAPI (backend/.env): comma-separated origins; set CORS_ORIGIN_REGEX only if needed
# APP_ENV=development
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3001
# CORS_ORIGIN_REGEX=https://studio-.*\.vercel\.app
# HEALTH_DEPS_TOKEN=   # required in production for GET /health/deps

# Use local-only sample credentials here; never commit production database credentials.
# DATABASE_URL=postgresql://studio:studio@localhost:5432/studio

# Object storage — presign/register always go through FastAPI (no Next.js S3 secrets)
# STORAGE_BACKEND=local   # local | r2 | s3 | auto (default: auto-detect)

# Cloudflare R2 (recommended)
# STORAGE_BACKEND=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=studio-dev
# R2_PUBLIC_BUCKET_NAME=studio-dev-public
# R2_PUBLIC_BASE_URL=https://cdn-dev.studio.mist.com
# R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# R2_REGION=auto
# R2_FORCE_PATH_STYLE=true

# Legacy AWS S3 (STORAGE_BACKEND=s3)
# AWS_BUCKET=studio-prod
# AWS_REGION=us-east-1
# AWS_S3_ENDPOINT=
# AWS_S3_FORCE_PATH_STYLE=false
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# CDN / file URLs in API responses (model_url, swatch_url, embed)
# PUBLIC_CDN_ORIGIN=https://cdn.studio.mist.com
# PUBLIC_API_BASE=https://api.studio.mist.com

# Backend AI background (backend/.env)
# AI_BACKGROUND_MODE=stub   # stub | sdxl | off
# PUBLIC_API_BASE=http://127.0.0.1:8765   # absolute URLs in /ai-background JSON (optional)

# Auth + email (backend/.env)
# APP_PUBLIC_URL=http://localhost:3000
# EMAIL_FROM=studio@mist.com
# CONTACT_NOTIFY_EMAIL=support@mist.com
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true

# Observability (optional — Sentry DSN is public and safe in client env)
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# NEXT_PUBLIC_SENTRY_RELEASE=mist-studio@0.1.0
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE=mist-studio@0.1.0
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# Backend observability + abuse protection (backend/.env)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE=mist-studio-api@0.1.0
# SENTRY_TRACES_SAMPLE_RATE=0.1
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_UPLOAD_PRESIGN_PER_HOUR=30
# RATE_LIMIT_UPLOAD_REGISTER_PER_HOUR=30
# RATE_LIMIT_UPLOAD_DIRECT_PER_HOUR=20
# RATE_LIMIT_AI_BACKGROUND_PER_HOUR=60
# MAX_UPLOAD_BYTES=104857600

# Stripe Billing (backend/.env — use a restricted key in production)
# STRIPE_SECRET_KEY=rk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_GROW=price_...
# STRIPE_PRICE_STUDIO=price_...
# STRIPE_PRICE_TOPUP_MODEL_10=price_...
# STRIPE_PRICE_TOPUP_MODEL_25=price_...
# STRIPE_PRICE_TOPUP_AI_50=price_...
# STRIPE_PRICE_TOPUP_AI_150=price_...
