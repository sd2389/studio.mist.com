# Copy to .env and fill in values. Never commit .env.

APP_ENV=development
DATABASE_URL=postgresql+psycopg2://studio:studio@localhost:5433/studio

CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
# APP_PUBLIC_URL is also added to the CORS allowlist automatically.
# Optional: allow Vercel preview deploys (use a project-specific pattern in production)
# CORS_ORIGIN_REGEX=https://studio-.*\.vercel\.app

# Required in production to access GET /health/deps (send as X-Health-Token header)
# HEALTH_DEPS_TOKEN=

# Shared with the web server: only a request carrying it has its X-Client-IP believed for
# per-IP rate limits. Unset, sign-ins through the web app share one budget (warned in production).
# INTERNAL_PROXY_TOKEN=

# Required in production for API keys (/v1): the server secret their hashes are made with, at
# least 32 characters, e.g. from `openssl rand -hex 32`. Changing it invalidates every key.
# API_KEY_PEPPER=

# Storage: local | r2 | s3 | auto
STORAGE_BACKEND=r2

# Cloudflare R2 (server-side only)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=studio-dev
R2_PUBLIC_BUCKET_NAME=studio-dev-public
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_REGION=auto
R2_FORCE_PATH_STYLE=true
R2_PUBLIC_BASE_URL=https://cdn-dev.studio.mist.com

# Legacy S3 (STORAGE_BACKEND=s3)
# AWS_BUCKET=
# AWS_REGION=us-east-1

AI_BACKGROUND_MODE=stub
PUBLIC_API_BASE=http://127.0.0.1:8765
APP_PUBLIC_URL=http://localhost:3000
EMAIL_FROM=studio@mist.com
